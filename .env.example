NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/healthcare_tracker

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend / CORS
CLIENT_ORIGIN=http://localhost:5173

# Medication reminders
REMINDER_POLL_INTERVAL_MS=60000
ALERT_REPEAT_INTERVAL_MS=900000
ALERT_DELIVERY_MODE=console

# File uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Email for forgot-password
# Leave blank to log emails to the backend console in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Legacy OTP settings
# Optional: only needed if you keep or re-enable the OTP flow
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_MODE=console
